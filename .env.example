PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only sb_secret_... key (Supabase dashboard → Project Settings → API keys →
# "Publishable and secret API keys"; or `supabase projects api-keys --reveal`). Used by
# the user-management form actions (account creation, password resets, membership).
PRIVATE_SUPABASE_SECRET_KEY=
# adapter-node runtime (the built server reads these from the process environment;
# Node does not load .env files by itself — use `node --env-file=.env build` or pass
# them from the service manager). ORIGIN must match the public URL or form actions
# are rejected as cross-site.
ORIGIN=https://example.com
PORT=3000
PRIVATE_CHAKRA_API_KEY=
PRIVATE_CHAKRA_PLUGIN_ID=
PRIVATE_CHAKRA_WHATSAPP_PHONE_NUMBER_ID=
PRIVATE_CHAKRA_WHATSAPP_API_VERSION=
